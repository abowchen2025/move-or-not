root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 需要 BOM 才會以 UTF-8 讀取腳本
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4
